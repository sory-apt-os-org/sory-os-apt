{
  "repository": "sory-os-org/sory-os-apt",
  "source_org": "sory-os-org",
  "libcosmic": {
    "git": "https://github.com/sory-os-org/libcosmic.git",
    "branch": "main"
  },
  "vendor_repos": {
    "accounts": {
      "git": "https://github.com/sory-os-org/accounts.git",
      "branch": "main",
      "used_by": ["tasks"]
    }
  },
  "release_tag_prefix": "soryos-cosmic-utils",
